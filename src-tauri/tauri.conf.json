{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BTT Dive Planner",
  "version": "0.3.0",
  "identifier": "hu.bttexplorers.diveplanner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BTT Dive Planner",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "msi"],
    "category": "Utility",
    "shortDescription": "Decompression and gas planner",
    "longDescription": "BTT Dive Planner – Bühlmann ZH-L16C decompression and gas planning with GUE and PADI/SSI gas standards. UI in Hungarian and English.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Hungarian", "English"]
      }
    }
  }
}
